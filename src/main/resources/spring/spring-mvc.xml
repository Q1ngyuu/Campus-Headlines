<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpringMVC 容器：Controller / 视图解析 / 静态资源 / 文件上传 / 拦截器
  由 web.xml 中的 DispatcherServlet 加载
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- ============================================================
         1. 只扫描 Controller 层
         ============================================================ -->
    <context:component-scan base-package="com.campus.headlines.controller"/>

    <!-- 上传目录的占位符：mvc:resources 的 file:${upload.base-path} 需要在这里解析。
         MVC 子容器看不到根容器的 PropertyPlaceholder，所以单独声明一份 -->
    <context:property-placeholder location="classpath:properties/upload.properties"
                                  file-encoding="UTF-8"
                                  ignore-resource-not-found="true"
                                  ignore-unresolvable="true"/>

    <!-- ============================================================
         2. 注解驱动
         - 处理器映射/适配器、@ResponseBody 的 JSON 转换器由框架自动注册
         - 显式指定 UTF-8 的 StringHttpMessageConverter：
           Spring 默认用 ISO-8859-1 输出 String，会导致中文乱码
         - 自定义 ObjectMapper：LocalDateTime 输出 yyyy-MM-dd HH:mm:ss，
           而不是默认的 [2026,10,26,19,28,41] 数组
         ============================================================ -->
    <bean id="jacksonObjectMapper"
          class="com.campus.headlines.config.JacksonConfig"
          factory-method="build"/>

    <mvc:annotation-driven>
        <mvc:message-converters register-defaults="true">
            <bean class="org.springframework.http.converter.StringHttpMessageConverter">
                <constructor-arg value="UTF-8"/>
            </bean>
            <bean class="org.springframework.http.converter.json.MappingJackson2HttpMessageConverter">
                <property name="objectMapper" ref="jacksonObjectMapper"/>
            </bean>
        </mvc:message-converters>
    </mvc:annotation-driven>

    <!-- ============================================================
         3. 视图解析器：Controller 返回 "news/list" -> /WEB-INF/views/news/list.jsp
         ============================================================ -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
        <!-- 让 JSP 页面可以用 ${...} 正常取值 -->
        <property name="viewClass"
                  value="org.springframework.web.servlet.view.JstlView"/>
    </bean>

    <!-- ============================================================
         4. 静态资源映射
         DispatcherServlet 映射了 "/"，会接管所有请求，
         所以 /static/** 必须显式交给容器的默认 Servlet 处理，
         否则 CSS/JS/图片会 404
         ============================================================ -->
    <mvc:resources mapping="/static/**" location="/static/"/>
    <!-- 上传文件：磁盘目录在 webapp 之外（upload.base-path），
         用 file: 前缀直接映射，war 重新部署也不会丢文件 -->
    <mvc:resources mapping="/upload/**" location="file:${upload.base-path}/"/>

    <!-- 兜底：未匹配到任何 Controller 的请求交回 Tomcat 默认 Servlet -->
    <mvc:default-servlet-handler/>

    <!-- ============================================================
         5. 文件上传解析器
         bean id 必须是 multipartResolver，否则 DispatcherServlet 认不出来

         这里放宽到 单文件 50MB / 单次请求 100MB：原来的 10MB/50MB
         会让 mp4 基本传不上去。类型级限制（图片 10MB、视频 50MB）
         由 FileUploadUtil 按扩展名二次校验，见 upload.properties
         ============================================================ -->
    <bean id="multipartResolver"
          class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <property name="defaultEncoding" value="UTF-8"/>
        <property name="maxUploadSize" value="104857600"/>
        <property name="maxUploadSizePerFile" value="52428800"/>
        <!-- 小于该阈值的文件只放内存，超过才写临时文件 -->
        <property name="maxInMemorySize" value="4096"/>
        <!-- 延迟解析：在 Controller 里访问 getFile 时才解析，异常更好处理 -->
        <property name="resolveLazily" value="true"/>
    </bean>

    <!--
      —— 备选：Servlet 3.0+ 原生上传（不依赖 commons-fileupload，但单文件大小要在
         web.xml 的 <multipart-config> 里限制，无法只靠 XML 精确控制单文件大小）
      <bean id="multipartResolver"
            class="org.springframework.web.multipart.support.StandardServletMultipartResolver"/>
    -->

    <!-- ============================================================
         6. 登录拦截器
         采用「白名单包含要保护的路径」而不是拦截 /** 再排除：
         新增公开页面时不用改配置，忘记配置的后果是“没保护”而不是“全站 401”。

         受保护：投稿、草稿、上传、后台管理
         放行  ：登录/注册接口、列表与详情、静态资源、上传回显（logo/图片展示）

         未登录时由 LoginInterceptor 自行判断返回 JSON(401) 还是 302 跳登录页
         ============================================================ -->
    <mvc:interceptors>
        <mvc:interceptor>
            <!-- 需要登录才能访问的路径 -->
            <mvc:mapping path="/article/publish"/>
            <mvc:mapping path="/article/publish/**"/>
            <mvc:mapping path="/article/draft"/>
            <mvc:mapping path="/article/submit/**"/>
            <mvc:mapping path="/article/edit/**"/>
            <mvc:mapping path="/article/my"/>
            <mvc:mapping path="/article/my/**"/>
            <mvc:mapping path="/material/**"/>
            <mvc:mapping path="/favorite"/>
            <mvc:mapping path="/favorite/**"/>
            <mvc:mapping path="/admin/**"/>

            <!-- 显式放行（exclude 优先于 include） -->
            <mvc:exclude-mapping path="/user/login"/>
            <mvc:exclude-mapping path="/user/register"/>
            <mvc:exclude-mapping path="/login"/>
            <mvc:exclude-mapping path="/register"/>
            <mvc:exclude-mapping path="/article/list"/>
            <mvc:exclude-mapping path="/article/detail/**"/>
            <mvc:exclude-mapping path="/category/**"/>
            <mvc:exclude-mapping path="/static/**"/>
            <mvc:exclude-mapping path="/upload/**"/>

            <bean class="com.campus.headlines.interceptor.LoginInterceptor"/>
        </mvc:interceptor>

        <!-- 管理员拦截器：必须排在登录拦截器之后，
             前者判断“有没有登录”，后者判断“是不是管理员” -->
        <mvc:interceptor>
            <mvc:mapping path="/admin/**"/>
            <bean class="com.campus.headlines.interceptor.AdminInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

</beans>
