<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Campus Headlines</display-name>

    <!-- ============================================================
         1. Spring 根容器（Service / Mapper / 数据源 / 事务）
         由 ContextLoaderListener 启动，写入 ServletContext
         ============================================================ -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:spring/applicationContext.xml</param-value>
    </context-param>

    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!-- ============================================================
         2. 字符编码过滤器：必须放在所有过滤器最前面
         ============================================================ -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>forceRequestEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>forceResponseEncoding</param-name>
            <!-- 设为 false：否则图片/视频等二进制响应也会被追加上 charset=UTF-8，
                 变成 image/png;charset=UTF-8，虽然浏览器能显示但不规范。
                 JSP 与 JSON 各自已显式声明 UTF-8，不受影响 -->
            <param-value>false</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================
         3. REST 风格：让 JSP 表单里的 _method=PUT/DELETE 生效
         ============================================================ -->
    <filter>
        <filter-name>hiddenHttpMethodFilter</filter-name>
        <filter-class>org.springframework.web.filter.HiddenHttpMethodFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>hiddenHttpMethodFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 说明：FormContentFilter 只在 Spring Boot 自动配置里默认开启，
         SSM 下如需处理 PUT 请求体表单，可自行增加
         org.springframework.web.filter.FormContentFilter -->

    <!-- ============================================================
         4. DispatcherServlet：SpringMVC 子容器，映射 "/"
         子容器可访问根容器 Bean，反之不行
         ============================================================ -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>classpath:spring/spring-mvc.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         5. 会话与欢迎页
         ============================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================
         注意：
         1) 本项目基于 javax.servlet（Servlet 4.0），请使用 Tomcat 8.5 / 9.0。
         Tomcat 10+ 已改为 jakarta.servlet，直接部署会报 ClassNotFoundException。
         2) 如需 Tomcat 10，需把 Spring 升到 6.x + MyBatis-Plus 3.5.9+，不属于本次初始化范围。
         ============================================================ -->

</web-app>
